# Copy to a private environment file and inject it into the backend process.
# Spring Boot does not automatically load a repository .env file.
# Never copy the intelligentAI Backblaze master key into AWS credentials.

# Existing PostgreSQL database (AWS RDS in the deployment environment).
# Flyway manages recording metadata in this database; media bytes belong in S3.
DB_URL=jdbc:postgresql://localhost:5432/voice
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
JWT_ISSUER=voice-coaching
JWT_ACCESS_TOKEN_SECONDS=600
JWT_REFRESH_TOKEN_SECONDS=1209600
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Existing application cache, independent of the future analysis Redis stream.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
KAKAO_OAUTH_CLIENT_ID=
KAKAO_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# Keep disabled until the private recording bucket and IAM role exist.
# On EC2 prefer an instance profile through the AWS default credential chain.
# Native Backblaze credentials are not valid for the S3 client used here.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PATH_STYLE_ACCESS=false
OBJECT_STORAGE_RECORDINGS_PREFIX=recordings/
MEDIA_NORMALIZATION_ENABLED=false
MEDIA_NORMALIZATION_WORKSPACE_ROOT=/tmp/voice-coach-media-normalization
MEDIA_NORMALIZATION_SANDBOX_PYTHON_BINARY=/usr/bin/python3.12
MEDIA_NORMALIZATION_FFMPEG_BINARY=/usr/bin/ffmpeg
MEDIA_NORMALIZATION_FFPROBE_BINARY=/usr/bin/ffprobe
MEDIA_NORMALIZATION_PROCESS_TIMEOUT=PT30S
MEDIA_NORMALIZATION_MAXIMUM_INPUT_BYTES=104857600
MEDIA_NORMALIZATION_MAXIMUM_OUTPUT_BYTES=20971520
MEDIA_NORMALIZATION_MINIMUM_DURATION_MS=500
MEDIA_NORMALIZATION_MAXIMUM_DURATION_MS=180000

# Supply the approved voice-analysis policy revision before analyzing.
# Video registration uses the separate revision returned by analysis-capabilities.
# HMAC 서명 키는 분석 전송을 켤 때만 AI 연동과 공유한다.
ANALYSIS_CONSENT_POLICY_REVISION=
ANALYSIS_AUTHORIZATION_KEY_ID=
ANALYSIS_AUTHORIZATION_SIGNING_SECRET_BASE64=
ANALYSIS_AUTHORIZATION_GRANT_TTL=PT5M

# RunPod HTTP callback 전송 경로에서는 Redis Stream을 비활성화한다.
# 프로젝트가 Redis Stream MQ로 다시 전환될 때만 ANALYSIS_STREAM_ENABLED를 켠다.
ANALYSIS_STREAM_ENABLED=false
ANALYSIS_CLOSED_BETA_ENABLED=false

# RunPod HTTP callback 전송 설정.
# ANALYSIS_STREAM_ENABLED=false이고 Backend가 RunPod에 직접 분석 요청을 보낼 때 사용한다.
AI_ANALYSIS_TRANSPORT=disabled
RUNPOD_ENDPOINT_URL=
AI_ANALYSIS_API_TOKEN=
AI_ANALYSIS_CALLBACK_TOKEN=
AI_ANALYSIS_CALLBACK_BASE_URL=
AI_ANALYSIS_EXECUTION_TIMEOUT=PT15M
AI_ANALYSIS_HEARTBEAT_INTERVAL=PT15S
AI_ANALYSIS_CLAIM_TTL=PT90S
AI_ANALYSIS_DISPATCH_RETRY_MAX_ATTEMPTS=5
AI_ANALYSIS_CALLBACK_RETRY_MAX_ATTEMPTS=5

# 아래 ANALYSIS_REDIS_* / ANALYSIS_*_STREAM 값은 Redis Stream MQ 전환 시에만 사용한다.
# 현재 RunPod HTTP callback 전송에서는 비워 두거나 기본값을 유지한다.
ANALYSIS_REDIS_HOST=
ANALYSIS_REDIS_PORT=6379
ANALYSIS_REDIS_USERNAME=
ANALYSIS_REDIS_PASSWORD=
ANALYSIS_REDIS_SSL_ENABLED=true
ANALYSIS_REDIS_CONNECT_TIMEOUT=PT5S
ANALYSIS_REDIS_COMMAND_TIMEOUT=PT30S
ANALYSIS_REQUEST_STREAM=analysis:request:v1
ANALYSIS_REQUEST_CONSUMER_GROUP=analysis-workers
ANALYSIS_RESULT_STREAM=analysis:result:v1
ANALYSIS_RESULT_CONSUMER_GROUP=backend-analysis-result-workers
ANALYSIS_RESULT_CONSUMER_NAME=backend-analysis-result-1
ANALYSIS_CANCELLATION_KEY_PREFIX=analysis:canceled:v1:
ANALYSIS_STREAM_MAXIMUM_PAYLOAD_BYTES=65536
ANALYSIS_STREAM_MAXIMUM_RESULT_PAYLOAD_BYTES=1048576
ANALYSIS_MAX_CONCURRENT_PER_USER=3
ANALYSIS_EXECUTION_TIMEOUT=PT15M

# Explicit closed-beta deployments must set BOTH the mode and a reviewed bound.
# ANALYSIS_CLOSED_BETA_ENABLED=true
# ANALYSIS_STREAM_MAXIMUM_RESULT_PAYLOAD_BYTES=402653184
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=9091
