# Dedicated Backend evidence reader settings. Not loaded automatically.
# Supply only the backend-reader restricted key, not RunPod writer/master/recording credentials.
# Registration and verifier are separate from canonical admission; leave off until implemented and deployed.
# Safe defaults; the approved 2026-10-02 runtime enables these only with server readiness.
# Headerless clients remain legacy; explicit v4 is initially standalone audio pronunciation only.
ANALYSIS_CANONICAL_ADMISSION_ENABLED=false
ANALYSIS_CANONICAL_EVIDENCE_REGISTRATION_ENABLED=false
ANALYSIS_CANONICAL_EVIDENCE_VERIFIER_ENABLED=false
# Installed callback reader/verification lane, not admission. Requires canonical V33-V36 and complete consumers.
ANALYSIS_CANONICAL_EVIDENCE_CALLBACK_ENABLED=false
ANALYSIS_CANONICAL_EVIDENCE_CALLBACK_VERIFIER_ENABLED=false
ANALYSIS_CANONICAL_EVIDENCE_JOURNAL_ENABLED=false
ANALYSIS_CANONICAL_EVIDENCE_CALLBACK_APPLY_ENABLED=false
# Explicit approved DB spool capacity required; blank/zero keeps new reservations closed.
# Range: 16 MiB..16 GiB. Originals remain in B2; no automatic staging/orphan deletion.
ANALYSIS_CANONICAL_EVIDENCE_JOURNAL_STAGING_BUDGET_BYTES=
ANALYSIS_CANONICAL_EVIDENCE_B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
ANALYSIS_CANONICAL_EVIDENCE_B2_REGION=us-east-005
ANALYSIS_CANONICAL_EVIDENCE_B2_BUCKET=speakai2026
ANALYSIS_CANONICAL_EVIDENCE_B2_PREFIX=canonical-evidence/v1/
ANALYSIS_CANONICAL_EVIDENCE_B2_KEY_ID=
ANALYSIS_CANONICAL_EVIDENCE_B2_APPLICATION_KEY=
ANALYSIS_CANONICAL_EVIDENCE_RETENTION_DAYS=INDEFINITE
ANALYSIS_CANONICAL_EVIDENCE_DELETION_GRACE_HOURS=INDEFINITE
ANALYSIS_CANONICAL_EVIDENCE_ORPHAN_GRACE_HOURS=INDEFINITE
# Absolute paths pinned/verified by deployment; no default installation is assumed.
ANALYSIS_CANONICAL_EVIDENCE_SEMANTIC_PYTHON=
ANALYSIS_CANONICAL_EVIDENCE_SEMANTIC_SCRIPT=
ANALYSIS_CANONICAL_EVIDENCE_SEMANTIC_CORE_ROOT=
ANALYSIS_CANONICAL_EVIDENCE_SEMANTIC_LLM_ROOT=
ANALYSIS_CANONICAL_EVIDENCE_SEMANTIC_RECORDINGS_PREFIX=
