# Private /etc/alpha-payment-test/backend.env (root:root 0600).
# Replace placeholders privately; never commit a filled file.
SPRING_PROFILES_ACTIVE=payment-test
DB_URL=jdbc:postgresql://127.0.0.1:15435/payment_sandbox
DB_USERNAME=payment_test_app
DB_PASSWORD=REPLACE_WITH_NEW_TEST_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_NEW_TEST_ONLY_SIGNING_SECRET
JWT_ISSUER=speakai-payment-sandbox
PAYMENT_TEST_ENABLED=true
PAYMENT_TEST_ALLOWED_USER_IDS=1
PAYMENT_TEST_RECOVERY_ENABLED=true
PORTONE_STORE_ID=REPLACE_WITH_STORE_ID
PORTONE_TEST_CHANNEL_KEY=REPLACE_WITH_TEST_CHANNEL_KEY
PORTONE_API_SECRET=REPLACE_WITH_PRIVATE_API_SECRET
PORTONE_WEBHOOK_SECRET=REPLACE_WITH_PRIVATE_TEST_WEBHOOK_SECRET
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18180
SERVER_FORWARD_HEADERS_STRATEGY=framework
SPRINGDOC_PATHS_TO_MATCH=/api/auth/login,/api/auth/token/refresh,/api/auth/logout,/api/payment-orders/**,/api/payment-orders,/api/refund-requests/**,/api/users/me,/api/users/me/payment-orders,/api/payments/webhooks/portone
MANAGEMENT_SERVER_ADDRESS=127.0.0.1
MANAGEMENT_SERVER_PORT=19191
MANAGEMENT_HEALTH_REDIS_ENABLED=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=2
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=0
SERVER_TOMCAT_THREADS_MAX=8
SERVER_TOMCAT_THREADS_MIN_SPARE=1
SERVER_TOMCAT_MAX_CONNECTIONS=40
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
CORS_ALLOWED_ORIGINS=https://vc-fe.vercel.app,http://localhost:3000
REDIS_HOST=127.0.0.1
REDIS_PORT=16379
AWS_EC2_METADATA_DISABLED=true
AI_ANALYSIS_TRANSPORT=disabled
ANALYSIS_STREAM_ENABLED=false
AI_ANALYSIS_ADMISSION_ENABLED=false
OBJECT_STORAGE_ENABLED=false
PROFILE_IMAGE_ENABLED=false
CHIRP_TTS_ENABLED=false
PRACTICE_REMINDERS_ENABLED=false
SPRING_JPA_SHOW_SQL=false
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_WEB=WARN
LOGGING_LEVEL_ORG_HIBERNATE_SQL=WARN
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=OFF
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_BOOT_SECURITY_AUTOCONFIGURE=ERROR
